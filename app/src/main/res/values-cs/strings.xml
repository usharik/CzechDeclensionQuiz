    <string name="tip_adj_hard">V 1. pádě mn. č. mužského životného rodu se mění souhláska: mladý → mladí, hezký → hezcí, drahý → drazí, český → čeští. 4. pád j. č. životných = 2. pád (mladého).</string>
    <string name="tip_adj_soft">Jeden tvar pro všechny rody v 1. pádě (jarní den, jarní noc, jarní ráno). Ostatní pády: -ího, -ímu, -ím. Stejně se skloňují 2. stupně (lepší, starší).</string>
    <string name="tip_adj_possessive">Krátké koncovky jako u podstatných jmen: otcova, otcovu, otcově. -ův od mužského vlastníka (otec), -in od ženského (matka → matčin).</string>
    <string name="tip_verb_dela">Skupina -á: -ám, -áš, -á, -áme, -áte, -ají. Rozkaz na -ej: dělej, dělejte! Patří sem většina sloves na -at.</string>
    <string name="tip_verb_prosi">Skupina -í: -ím, -íš, -í, -íme, -íte, -í (nebo -ějí: umějí). Rozkaz bez koncovky: pros!, mluv!; po dvou souhláskách -i: mysli!</string>
    <string name="tip_verb_kupuje">Skupina -uje: -uji/-uju, -uješ, -uje, -ujeme, -ujete, -ují/-ujou (tvary -uju/-ujou jsou hovorové). Rozkaz -uj: kupuj!</string>
    <string name="tip_verb_tiskne">Skupina -ne: -nu, -neš, -ne, -neme, -nete, -nou. Rozkaz -ni: tiskni!, sedni si! V minulém čase často odpadá -nu-: tiskl, sedl.</string>
    <string name="tip_verb_nese">Skupina -e: -u, -eš, -e, -eme, -ete, -ou. Kmen se často mění: číst → čtu, psát → píšu, péct → peču. Rozkaz: čti!, piš!, peč!</string>
    <string name="tip_verb_irregular">Učte se jedno po druhém: být (jsem, jsi, je…), mít (mám), jít (jdu, min. šel/šla), chtít (chci), vědět (vím), jíst (jím), moct (můžu).</string>
    <string name="tip_past_tense">Minulý čas = příčestí + jsem/jsi/jsme/jste; ve 3. osobě bez pomocného slovesa: dělal jsem, dělala jsi, dělali jsme, dělal. Pozor na množné číslo: oni dělali, ony dělaly.</string>
